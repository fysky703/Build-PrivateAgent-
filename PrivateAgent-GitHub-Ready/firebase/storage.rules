rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /wallpapers/{agentId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.token.admin == true || request.auth.uid == agentId);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /media/{agentId}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.token.admin == true || request.auth.uid == agentId);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
